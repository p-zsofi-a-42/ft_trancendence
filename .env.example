# Add required environment variable names here as the app grows.
POSTGRES_USER=your_database_user_here
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=your_database_name_here

# Session password used by nuxt-auth-utils inside the web container (min 32 chars)
NUXT_SESSION_PASSWORD=your_session_password_here
# Secret used for signing and verifying tokens (min 32 chars)
TOKEN_SECRET=your_token_secret_here

# User and group ID for development (used by Docker Compose for dev services)
DEV_UID=#id -u
DEV_GID=#id -g

# Game database
GAME_DB_USER=your_database_user_here
GAME_DB_PASSWORD=your_database_password_here
GAME_DB_NAME=your_database_name_here

# OAuth configuration for 42 and GitHub
# CLIENT_ID: public identifier for the OAuth provider, 
#   obtained after registering your app with the provider
# CLIENT_SECRET: secret key for the OAuth provider, 
#   obtained after registering your app with the provider
NUXT_OAUTH_42_CLIENT_ID=<from 42>
NUXT_OAUTH_42_CLIENT_SECRET=<from 42>
NUXT_OAUTH_GITHUB_CLIENT_ID=<from GitHub>
NUXT_OAUTH_GITHUB_CLIENT_SECRET=<from GitHub>
NUXT_OAUTH_REDIRECT_URI=<from your app configuration>
# 32-byte random key, base64 encoded, for encrypting stored provider tokens.
# Generate with: openssl rand -base64 32
NUXT_OAUTH_TOKEN_KEY=<generate with openssl rand -base64 32>

